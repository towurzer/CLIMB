# Copy to .env (setup_climb.sh does that the first time) and set the password and CLIMB_SOURCE_ROOT.
# README "Environment Variables" explains the service lines, config.py every CLIMB_* knob.

POSTGRES_DB_NAME=CLIMB_DB
POSTGRES_PASSWORD=change-me
SEARCH_ENGINE_URL=localhost
SEARCH_ENGINE_PORT=5000
REDIS_URL=redis://localhost:6379
VIDEOS_CACHE_TTL_SECONDS=30
DB_PORT=5432
DB_HOST=localhost
BACKEND_URL=localhost
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGIN_REGEX=^https?:\/\/(?:[a-zA-Z0-9-]+\.)*q1studios\.at(?::\d+)?$

# Where the source collections are mounted: VBS/videos/..., V3Cmeta/..., MVKmeta/..., LHEmeta/...
CLIMB_SOURCE_ROOT=/run/media/you/Data

# Keyframes and thumbnails kept (~33 MB per hour of video), and scratch space (a few GB at a time).
# Both default to dataset/media and dataset/work in this repository.
#CLIMB_MEDIA_DIR=/big/disk/climb/media
#CLIMB_WORK_DIR=/big/disk/climb/work

# The containers setup_climb.sh creates; another volume name is another, empty database.
#CLIMB_DB_CONTAINER=climb
#CLIMB_DB_VOLUME=postgres_data
#CLIMB_CACHE_CONTAINER=climb_caching
# The database answers on this machine only; 0.0.0.0 opens it to shards on other machines (README 1.7).
#CLIMB_DB_BIND=127.0.0.1

# AVS sessions shared across machines (README 2.6); left out, they stay on this machine.
#AVS_SESSION_SERVICE_URL=https://example.org
#AVS_SESSION_TOKEN=supersecrettoken
#CLIMB_USER=AlexHonold
